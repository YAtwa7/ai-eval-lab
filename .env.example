# Copy to .env.local (gitignored). Never commit real values.
# This repo is public: keys live here and nowhere else.

# --- generator / judge providers -------------------------------------------
# Primary: Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback 1: Groq (OpenAI-compatible). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 2: OpenRouter (OpenAI-compatible). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Fallback 3: Ollama, fully local and offline. No key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- observability ----------------------------------------------------------
# LangSmith: free Developer tier (5k base traces/mo). https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Arize Phoenix: self-hosted and 100% free. Started with `phoenix serve`.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006

# Langfuse: self-hosted and free. Only needed if you run it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3001
